# FILE UTILS: sélection du fichier le plus récent et lecture sécurisée.
def latest(files):
    x=[f for f in files if f.exists()]
    return max(x,key=lambda f:f.stat().st_mtime) if x else None

def read_csv(path):
    try:return pd.read_csv(path)
    except Exception as e:st.error(f'Lecture impossible : {e}');return None

# DATA EXPLORER: filtres avancés + pagination + export du résultat.
# Cette section permet à l'utilisateur de :
# 1) sélectionner plusieurs pages ;
# 2) rechercher un texte dans toutes les colonnes textuelles ;
# 3) filtrer les colonnes catégorielles ;
# 4) filtrer automatiquement les colonnes numériques ;
# 5) parcourir le résultat avec une pagination ;
# 6) télécharger uniquement les lignes actuellement filtrées.

def table_view(df, key):
    st.markdown("### 🔎 Filtrer et parcourir les données")
    st.caption(
        "Utilisez plusieurs filtres simultanément. "
        "Le tableau et le téléchargement sont mis à jour automatiquement."
    )

    work = df.copy()

    # ---------------------------
    # BARRE DE RECHERCHE GLOBALE
    # ---------------------------
    search = st.text_input(
        "🔍 Recherche globale",
        placeholder="Ex. Toyota, Camry, Poetry, Dakar, Manuelle...",
        key=key + "_search",
    )

    if search.strip():
        mask = pd.Series(False, index=work.index)
        for col in work.columns:
            if work[col].dtype == "object" or pd.api.types.is_string_dtype(work[col]):
                mask = mask | work[col].astype(str).str.contains(
                    search.strip(), case=False, na=False, regex=False
                )
        work = work[mask]

    # ---------------------------
    # FILTRES
    # ---------------------------
    with st.expander("⚙️ Filtres avancés", expanded=True):
        f1, f2 = st.columns(2)

        # Sélection multiple des pages.
        if "page" in work.columns:
            page_values = sorted(
                pd.to_numeric(work["page"], errors="coerce")
                .dropna()
                .astype(int)
                .unique()
                .tolist()
            )
            with f1:
                selected_pages = st.multiselect(
                    "📄 Pages à afficher — sélection multiple",
                    page_values,
                    default=page_values,
                    key=key + "_pages",
                )
            if selected_pages:
                work = work[
                    pd.to_numeric(work["page"], errors="coerce").isin(selected_pages)
                ]
            else:
                work = work.iloc[0:0]

        # Filtres catégoriels utiles : marque, modèle, catégorie, boîte, région...
        categorical_candidates = []
        for col in work.columns:
            if col == "page":
                continue
            if work[col].dtype == "object" or pd.api.types.is_string_dtype(work[col]):
                nunique = work[col].dropna().astype(str).nunique()
                if 1 < nunique <= 40:
                    categorical_candidates.append(col)

        # On donne priorité aux colonnes métier les plus utiles.
        priority = [
            "category", "brand", "model", "gearbox",
            "availability", "rating", "region"
        ]
        categorical_candidates.sort(
            key=lambda c: (priority.index(c) if c in priority else 99, c)
        )

        for i, col in enumerate(categorical_candidates[:6]):
            values = sorted(work[col].dropna().astype(str).unique().tolist())
            selected = st.multiselect(
                f"🏷️ {col}",
                values,
                key=f"{key}_cat_{col}",
            )
            if selected:
                work = work[work[col].astype(str).isin(selected)]

        # Filtres numériques : prix, année, kilométrage, reviews, etc.
        numeric_cols = []
        for col in work.columns:
            numeric = pd.to_numeric(work[col], errors="coerce")
            if numeric.notna().sum() > 0 and numeric.nunique(dropna=True) > 1:
                numeric_cols.append(col)

        preferred_numeric = [
            "price", "mileage", "year", "reviews",
            "products_count", "position_page"
        ]
        numeric_cols.sort(
            key=lambda c: (
                preferred_numeric.index(c) if c in preferred_numeric else 99,
                c
            )
        )

        for col in numeric_cols[:4]:
            numeric = pd.to_numeric(work[col], errors="coerce").dropna()
            if numeric.empty:
                continue

            minimum = float(numeric.min())
            maximum = float(numeric.max())

            if minimum == maximum:
                continue

            step = 1.0
            if maximum >= 10000:
                step = 1000.0
            elif maximum >= 100:
                step = 10.0

            selected_range = st.slider(
                f"📐 {col}",
                min_value=minimum,
                max_value=maximum,
                value=(minimum, maximum),
                step=step,
                key=f"{key}_range_{col}",
            )

            numeric_all = pd.to_numeric(work[col], errors="coerce")
            work = work[
                numeric_all.between(
                    selected_range[0],
                    selected_range[1],
                    inclusive="both",
                )
            ]

    # ---------------------------
    # PAGINATION
    # ---------------------------
    rows_col, page_col, info_col = st.columns([1, 1, 2])

    with rows_col:
        rows = st.selectbox(
            "Lignes par page",
            [10, 25, 50, 100],
            index=1,
            key=key + "_rows",
        )

    total_pages = max(1, (len(work) + rows - 1) // rows)

    with page_col:
        current_page = st.selectbox(
            "Page du tableau",
            list(range(1, total_pages + 1)),
            index=0,
            key=key + "_table_page",
        )

    with info_col:
        st.metric(
            "Résultats",
            f"{len(work):,}",
            help="Nombre de lignes après application de tous les filtres.",
        )

    first = (current_page - 1) * rows
    last = first + rows
    displayed = work.iloc[first:last]

    st.dataframe(
        displayed,
        use_container_width=True,
        height=470,
        hide_index=True,
    )

    # ---------------------------
    # EXPORT DES DONNÉES FILTRÉES
    # ---------------------------
    csv_data = work.to_csv(index=False).encode("utf-8-sig")

    c1, c2 = st.columns([1, 4])
    with c1:
        st.download_button(
            "⬇️ Exporter le filtre",
            data=csv_data,
            file_name=f"{key}_filtered.csv",
            mime="text/csv",
            key=key + "_filtered_download",
            use_container_width=True,
        )
    with c2:
        st.caption(
            f"Affichage : lignes {first + 1 if len(work) else 0}–"
            f"{min(last, len(work))} sur {len(work):,} "
            f"• page {current_page}/{total_pages}"
        )

    return work


