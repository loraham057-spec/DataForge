# Data Collection - Streamlit V3
# Application: scraping, download, dashboard, filtering and evaluation.
import os, sys, subprocess, time
from pathlib import Path
import pandas as pd
import streamlit as st
from data_database import (
    init_database, sync_dataset, read_table, table_count,
    list_tables, database_path, database_size
)

# CONFIGURATION: chemins et fichiers utilisés par l'application.
ROOT=Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
SCRAPING=ROOT/'scraping'; RAW=ROOT/'data'/'raw'; CLEANED=ROOT/'data'/'cleaned'
BOOKS=SCRAPING/'books_scraper.py'; BOOKS_DETAILS=SCRAPING/'complete_books_details.py'
GAARAAS=SCRAPING/'gaaraas_full_scraper.py'; GAARAAS_RESUME=SCRAPING/'gaaraas_resume_scraper.py'
BOOK_FILES=[RAW/'books_raw_webscraper.csv',CLEANED/'books_full.csv',CLEANED/'books_clean.csv']
GAARAAS_FILES=[RAW/'gaaraas_raw_webscraper.csv',CLEANED/'gaaraas_full.csv',CLEANED/'gaaraas_clean.csv']

st.set_page_config(page_title='MY DATA COLLECTION APP DATAFORGE',page_icon='📊',layout='wide',initial_sidebar_state='expanded')
init_database(ROOT)
# ============================================================
# V12_SETTINGS
# Un seul bouton ⚙️ Paramètres en haut à droite.
# Les réglages Couleur, Langue et Lieu sont centralisés ici.
# ============================================================

THEMES = {
