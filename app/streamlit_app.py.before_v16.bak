def run_script(script):
    if not script.exists():st.error(f'Script introuvable : {script}');return False
    env=os.environ.copy();env['PYTHONIOENCODING']='utf-8';env['PYTHONUTF8']='1'
    box=st.empty();lines=[]
    proc=subprocess.Popen([sys.executable,str(script)],cwd=str(ROOT),stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,encoding='utf-8',errors='replace',bufsize=1,env=env)
    for line in proc.stdout:
        if line.strip():lines.append(line.rstrip());box.code('\n'.join(lines[-35:]),language='text')
    proc.wait()
    if proc.returncode:st.error(f'❌ {script.name} a échoué (code {proc.returncode}).');return False
    st.success(f'✅ {script.name} terminé.');return True

# BOOK SCRAPER: lance Books puis la complétion des détails.
def scrape_books():
    if not run_script(BOOKS):return False
    if BOOKS_DETAILS.exists() and (CLEANED/'books_full.csv').exists() and not run_script(BOOKS_DETAILS):return False
    f=latest(BOOK_FILES)
    if f:
        st.success(f'📄 Fichier Books : {f.name}')
        try:
            n = sync_dataset(ROOT, "books", f)
            st.success(f'🗄️ SQL synchronisée : {n:,} lignes dans la table books.')
        except Exception as e:
            st.warning(f'⚠️ Fichier créé, mais synchronisation SQL impossible : {e}')
        st.session_state.last_output=str(f)
        return True
    return False

# GAARAAS SCRAPER: utilise prioritairement le script de reprise validé.
def scrape_gaaraas():
    script=GAARAAS_RESUME if GAARAAS_RESUME.exists() else GAARAAS
    if not run_script(script):return False
    f=latest(GAARAAS_FILES)
    if f:
        st.success(f'📄 Fichier Gaaraas : {f.name}')
        try:
            n = sync_dataset(ROOT, "gaaraas", f)
            st.success(f'🗄️ SQL synchronisée : {n:,} lignes dans la table gaaraas.')
        except Exception as e:
            st.warning(f'⚠️ Fichier créé, mais synchronisation SQL impossible : {e}')
        st.session_state.last_output=str(f)
        return True
    return False

# DOWNLOAD: expose les fichiers RAW et CLEANED au téléchargement.
def downloads(files):
    found=[f for f in files if f.exists()]
    if not found:st.warning('Aucun fichier disponible.');return
    for f in found:
        c1,c2=st.columns([3,1]);c1.write(f'📄 **{f.name}**');c2.download_button('⬇️ Télécharger',f.read_bytes(),f.name,'text/csv',key='dl_'+str(f),use_container_width=True)

# BOOK DASHBOARD: indicateurs, graphiques et tableau filtrable Books.
def books_dashboard():
    f=latest(BOOK_FILES)
    if not f:st.warning('Aucun dataset Books disponible.');return
    df=read_csv(f)
    if df is None:return
    st.markdown('## 📚 Books to Scrape');st.markdown('<div class="section-line"></div>',unsafe_allow_html=True)
    price=pd.to_numeric(df['price'].astype(str).str.replace('£','',regex=False),errors='coerce') if 'price' in df else pd.Series(dtype=float)
    rating=df['rating'].map({'One':1,'Two':2,'Three':3,'Four':4,'Five':5}) if 'rating' in df else pd.Series(dtype=float)
    a,b,c,d=st.columns(4);a.metric('📚 Livres',f'{len(df):,}');b.metric('💷 Prix moyen',f'£{price.mean():.2f}' if price.notna().any() else 'N/A');c.metric('⭐ Note moyenne',f'{rating.mean():.2f}/5' if rating.notna().any() else 'N/A');d.metric('🏷️ Catégories',df['category'].nunique() if 'category' in df else 'N/A')
    x,y=st.columns(2)
    with x:
        if 'category' in df:st.markdown('### 📊 Livres par catégorie');st.bar_chart(df['category'].value_counts().head(15))
    with y:
        if 'category' in df and price.notna().any():
            t=pd.DataFrame({'category':df['category'],'price':price});st.markdown('### 💷 Prix moyen par catégorie');st.bar_chart(t.groupby('category')['price'].mean().sort_values(ascending=False).head(15))
    table_view(df,'books')

# GAARAAS DASHBOARD: indicateurs, graphiques et tableau filtrable Gaaraas.
def gaaraas_dashboard():
    f=latest(GAARAAS_FILES)
    if not f:st.warning('Aucun dataset Gaaraas disponible.');return
    df=read_csv(f)
    if df is None:return
    st.markdown('## 🚗 Gaaraas');st.markdown('<div class="section-line"></div>',unsafe_allow_html=True)
    price=pd.to_numeric(df['price'],errors='coerce') if 'price' in df else pd.Series(dtype=float);mileage=pd.to_numeric(df['mileage'],errors='coerce') if 'mileage' in df else pd.Series(dtype=float)
    a,b,c,d=st.columns(4);a.metric('🚗 Annonces',f'{len(df):,}');b.metric('💰 Prix moyen',f'{price.mean():,.0f} XOF' if price.notna().any() else 'N/A');c.metric('🛣️ Kilométrage moyen',f'{mileage.mean():,.0f} km' if mileage.notna().any() else 'N/A');d.metric('🏷️ Marques',df['brand'].nunique() if 'brand' in df else 'N/A')
    x,y=st.columns(2)
    with x:
        if 'brand' in df:st.markdown('### 📊 Annonces par marque');st.bar_chart(df['brand'].value_counts().head(15))
    with y:
        if 'gearbox' in df:st.markdown('### ⚙️ Boîtes de vitesses');st.bar_chart(df['gearbox'].value_counts())
    table_view(df,'gaaraas')


# SQL DATABASE: interface de synchronisation, contrôle et consultation SQL.
def database_dashboard():
    st.markdown("## 🗄️ Base de données SQL")
    st.markdown('<div class="section-line"></div>', unsafe_allow_html=True)

    db_file = database_path(ROOT)
    st.info(
        "La base SQL stocke une table par source : `books` et `gaaraas`. "
        "Les données nettoyées sont synchronisées automatiquement après un scraping réussi."
    )

    a, b, c = st.columns(3)
    a.metric("📦 Tables", len([t for t in list_tables(ROOT) if t in ("books", "gaaraas")]))
    b.metric("📚 Books", f"{table_count(ROOT, 'books'):,}")
    c.metric("🚗 Gaaraas", f"{table_count(ROOT, 'gaaraas'):,}")

    st.caption(f"Fichier SQL local : `{db_file}` • Taille : {database_size(ROOT) / 1024:.1f} KB")

    st.markdown("### 🔄 Synchroniser les fichiers nettoyés vers SQL")

    sync_col1, sync_col2 = st.columns(2)

    with sync_col1:
        books_file = latest(BOOK_FILES)
        if books_file:
            st.write(f"📚 **Books** — `{books_file.name}`")
            if st.button("🔄 Synchroniser Books", use_container_width=True):
                try:
                    n = sync_dataset(ROOT, "books", books_file)
                    st.success(f"✅ {n:,} lignes enregistrées dans `books`.")
                except Exception as e:
                    st.error(f"❌ Synchronisation Books : {e}")
        else:
            st.warning("Aucun fichier Books disponible.")

    with sync_col2:
        gaaraas_file = latest(GAARAAS_FILES)
        if gaaraas_file:
            st.write(f"🚗 **Gaaraas** — `{gaaraas_file.name}`")
            if st.button("🔄 Synchroniser Gaaraas", use_container_width=True):
                try:
                    n = sync_dataset(ROOT, "gaaraas", gaaraas_file)
                    st.success(f"✅ {n:,} lignes enregistrées dans `gaaraas`.")
                except Exception as e:
                    st.error(f"❌ Synchronisation Gaaraas : {e}")
        else:
            st.warning("Aucun fichier Gaaraas disponible.")

    st.markdown("### 🔎 Consulter les données depuis SQL")

    table_choice = st.selectbox(
        "Table SQL",
        ["books", "gaaraas"],
        key="sql_table_choice",
    )

    if table_count(ROOT, table_choice) > 0:
        sql_df = read_table(ROOT, table_choice)
        st.success(f"Connexion SQL OK — {len(sql_df):,} lignes dans `{table_choice}`.")
        table_view(sql_df, "sql_" + table_choice)
    else:
        st.warning(
            f"La table `{table_choice}` ne contient encore aucune donnée. "
            "Lancez un scraping ou utilisez le bouton de synchronisation."
        )

# EVALUATION: contrôle technique avant branchement des formulaires Kobo/Google Forms.
def evaluation():
    st.markdown(f"## {L['evaluate']}");st.markdown('<div class="section-line"></div>',unsafe_allow_html=True)
    for name,f in [('📚 Books scraper',BOOKS),('📚 Books détails',BOOKS_DETAILS),('🚗 Gaaraas scraper',GAARAAS),('🔄 Gaaraas reprise',GAARAAS_RESUME)]:
        st.success(f'✅ {name} disponible' if f.exists() else f'❌ {name} introuvable')
    for f in BOOK_FILES+GAARAAS_FILES:
        if f.exists():
            try:st.info(f'📄 {f.name} — {len(pd.read_csv(f)):,} lignes')
            except:st.warning(f'⚠️ {f.name} est présent mais illisible.')

# SIDEBAR: navigation inspirée du visuel de référence.
st.sidebar.markdown('<div style="text-align:center;font-size:23px;font-weight:800;padding:8px 0 18px">📊 DATA COLLECTION</div>',unsafe_allow_html=True)
source=st.sidebar.selectbox(L["source"],['📚 Books to Scrape','🚗 Gaaraas'])
pages=st.sidebar.number_input(L["pages"],1,100,50 if source.startswith('📚') else 13)
mode=st.sidebar.selectbox(L["options"],[L["scrape"],L["download"],L["dashboard"],L["evaluate"]])
st.sidebar.markdown('---');st.sidebar.caption('Collect → RAW → Clean → Analyze → Download' if st.session_state.selected_language_v12.startswith('🇬🇧') else 'Collecte → RAW → Nettoyage → Analyse → Téléchargement')

# HOME HEADER: animation et présentation de l'application.
st.markdown('<div class="hero"><div class="hero-content"><h1>MY DATA COLLECTION APP DATAFORGE</h1><p>Plateforme interactive de scraping, nettoyage, téléchargement et visualisation.</p></div></div>',unsafe_allow_html=True)

if mode==L['scrape']:
    st.markdown(f"## {L['scrape']}");st.write(f'Source : **{source}** • Pages configurées : **{pages}**')
    st.markdown('<div class="card"><span class="live-dot"></span><b>Application prête</b><br><small>Les scrapers existants sont exécutés sans modifier leur logique interne.</small></div>',unsafe_allow_html=True)
    if st.button(L['start'],type='primary',use_container_width=True):
        start=time.time()
        with st.spinner('Collecte des données en cours...'):
            ok=scrape_books() if source.startswith('📚') else scrape_gaaraas()
        if ok:
            f=latest(BOOK_FILES if source.startswith('📚') else GAARAAS_FILES)
            st.success(f'🎉 Collecte terminée en {time.time()-start:.1f} secondes.')
            if f:st.download_button('⬇️ Télécharger immédiatement le résultat',f.read_bytes(),f.name,'text/csv',use_container_width=True)

elif mode==L['download']:
    st.markdown(f"## {L['download']}");st.write('Téléchargez les données RAW et CLEANED disponibles.');downloads(BOOK_FILES if source.startswith('📚') else GAARAAS_FILES)

elif mode==L['dashboard']:
    st.markdown(f"## {L['dashboard']}");st.write('Filtrez les pages et explorez les indicateurs.');books_dashboard() if source.startswith('📚') else gaaraas_dashboard()

elif mode=='🗄️ SQL Database':
    database_dashboard()

else:
    evaluation_dashboard()
