    },
    "🍷 Bordeaux": {
        "bg": "#FBF5F5", "bg2": "#FFFFFF", "side": "#641B2E",
        "accent": "#8E2C45", "highlight": "#C06C84",
        "text": "#3F1723", "muted": "#76616A"
    },
    "🌌 Cosmic": {
        "bg": "#F4F3FF", "bg2": "#FFFFFF", "side": "#24104F",
        "accent": "#6D28D9", "highlight": "#2563EB",
        "text": "#261A3A", "muted": "#6B6380"
    },
    "☕ Café": {
        "bg": "#FAF7F2", "bg2": "#FFFFFF", "side": "#5C4033",
        "accent": "#8B5E3C", "highlight": "#C89F7A",
        "text": "#3B2A21", "muted": "#77675D"
    },
}

LANGUAGES = {
    "🇫🇷 Français": {
        "source": "Source de données", "pages": "Pages indexes",
        "options": "Options", "scrape": "🚀 Scrape data",
        "download": "⬇️ Download scraped data",
        "dashboard": "📊 Dashboard of the data",
        "evaluate": "🧪 Evaluate the App", "start": "🚀 START SCRAPING",
        "settings": "Paramètres", "location": "Lieu / localisation",
        "theme": "Couleur / thème", "language": "Langue", "display_mode": "Mode d’affichage",
        "save": "💾 Enregistrer les paramètres",
        "saved": "Paramètres enregistrés.",
        "kobo_link": "Lien du formulaire KoboToolbox",
        "google_link": "Lien du formulaire Google Forms",
        "form_links": "Liens des formulaires",
        "open_kobo": "🚀 OUVRIR KOBOTOOLBOX",
        "open_google": "🚀 OUVRIR GOOGLE FORMS"
    },
    "🇬🇧 English": {
        "source": "Data source", "pages": "Page indexes",
        "options": "Options", "scrape": "🚀 Scrape data",
        "download": "⬇️ Download scraped data",
        "dashboard": "📊 Data dashboard",
        "evaluate": "🧪 Evaluate the App", "start": "🚀 START SCRAPING",
        "settings": "Settings", "location": "Location",
        "theme": "Color / theme", "language": "Language", "display_mode": "Display mode",
        "save": "💾 Save settings",
        "saved": "Settings saved.",
        "kobo_link": "KoboToolbox form link",
        "google_link": "Google Forms link",
        "form_links": "Form links",
        "open_kobo": "🚀 OPEN KOBOTOOLBOX",
        "open_google": "🚀 OPEN GOOGLE FORMS"
    },
}

if "selected_language_v12" not in st.session_state:
    st.session_state.selected_language_v12 = "🇫🇷 Français"

if "selected_theme_v12" not in st.session_state:
    st.session_state.selected_theme_v12 = "🏢 Corporate"

if "display_mode_v14" not in st.session_state:
    st.session_state.display_mode_v14 = "☀️ Clair"

if "app_location_v12" not in st.session_state:
    st.session_state.app_location_v12 = "Kinshasa, RDC"

# Liens des formulaires : modifiables depuis ⚙️ Paramètres.
if "kobo_form_url_v12" not in st.session_state:
    st.session_state.kobo_form_url_v12 = "https://ee.kobotoolbox.org/x/1oNIZ8OJ"

if "google_form_url_v12" not in st.session_state:
    st.session_state.google_form_url_v12 = "https://docs.google.com/forms/d/e/1FAIpQLScFmWJm7vxf0UYLhoVVr1V4UBpOADke6rzt1CrV4rgnFE2Wmg/viewform?usp=header"

if "settings_open_v12" not in st.session_state:
    st.session_state.settings_open_v12 = False

L = LANGUAGES[st.session_state.selected_language_v12]
THEME = THEMES[st.session_state.selected_theme_v12]

# Mode nuit : on conserve la couleur d'accent du thème mais on adapte
# le fond, les cartes, les textes et la barre latérale.
if st.session_state.display_mode_v14 == "🌙 Nuit":
    THEME = {
        **THEME,
        "bg": "#0B1220",
        "bg2": "#111827",
        "side": "#070D18",
        "text": "#F1F5F9",
        "muted": "#A7B0BF",
        "card": "#172033",
        "border": "#293548",
    }
else:
    THEME = {
        **THEME,
        "card": "#FFFFFF",
        "border": "#DCE3EA",
    }

# Header: only one settings button at top right.
_header, _settings = st.columns([8.5, 1.5])

with _header:
    st.markdown(
        f"""
        <div class="v12-header">
            <div class="v12-title">📊 MY DATA COLLECTION APP DATAFORGE</div>
            <div class="v12-subtitle">
                Collect, download and visualize web data
                &nbsp;•&nbsp; 📍 {st.session_state.app_location_v12}
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

st.markdown(
    """
    <div class="df-marquee-wrap">
        <div class="df-marquee">
            <span>⚡ DATAFORGE • Scraping • Nettoyage • Base de données • Visualisation • Évaluation •</span>
            <span>📊 DATAFORGE • Transformez vos données web en informations exploitables •</span>
            <span>🚀 DATAFORGE • Books to Scrape • Gaaraas • KoboToolbox • Google Forms •</span>
        </div>
    </div>
    """,
    unsafe_allow_html=True,
)

st.markdown(
    '<div class="df-status"><span class="df-status-dot"></span>DATAFORGE • Application prête</div>',
    unsafe_allow_html=True,
)


with _settings:
    if st.button(
        "⚙️ Paramètres" if st.session_state.selected_language_v12 == "🇫🇷 Français"
        else "⚙️ Settings",
        key="open_settings_v12",
        use_container_width=True,
    ):
        st.session_state.settings_open_v12 = not st.session_state.settings_open_v12
        st.rerun()

# Status visuel : information utile sans exposer les URLs.
st.markdown(
    f"""
    <div class="status-strip">
        <div class="status-pill"><span class="live-dot"></span><strong>Application</strong>&nbsp; prête</div>
        <div class="status-pill">📍 <strong>{st.session_state.app_location_v12}</strong></div>
        <div class="status-pill">🎨 <strong>{st.session_state.selected_theme_v12}</strong></div>
        <div class="status-pill">💡 <strong>{st.session_state.display_mode_v14}</strong></div>
    </div>
    """,
    unsafe_allow_html=True,
)

# Settings panel: theme, language, location and display mode.
if st.session_state.settings_open_v12:
    st.markdown(
        f"""
        <div class="settings-panel">
            <div class="settings-title">⚙️ {L["settings"]}</div>
            <div class="settings-subtitle">
                {"Personnalisez l’apparence, la langue et le lieu affiché dans l’application."
                if st.session_state.selected_language_v12 == "🇫🇷 Français"
                else "Customize the appearance, language and location displayed in the application."}
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

    s1, s2, s3, s4 = st.columns(4)

    with s1:
        new_theme = st.selectbox(
            f"🎨 {L['theme']}",
            list(THEMES.keys()),
            index=list(THEMES.keys()).index(st.session_state.selected_theme_v12),
            key="settings_theme_v12",
        )

    with s2:
        new_language = st.selectbox(
            f"🌐 {L['language']}",
            list(LANGUAGES.keys()),
            index=list(LANGUAGES.keys()).index(
                st.session_state.selected_language_v12
            ),
            key="settings_language_v12",
        )

    with s3:
        new_location = st.text_input(
            f"📍 {L['location']}",
            value=st.session_state.app_location_v12,
            key="settings_location_v12",
        )

    with s4:
        new_display_mode = st.selectbox(
            f"💡 {L['display_mode']}",
            ["☀️ Clair", "🌙 Nuit"],
            index=0 if st.session_state.display_mode_v14 == "☀️ Clair" else 1,
            key="settings_display_mode_v14",
        )

    st.markdown(f"### 🔗 {L['form_links']}")

    link1, link2 = st.columns(2)

    with link1:
        new_kobo_url = st.text_input(
            f"📝 {L['kobo_link']}",
            value=st.session_state.kobo_form_url_v12,
            key="settings_kobo_url_v12",
            placeholder="https://ee.kobotoolbox.org/x/..."
        )

    with link2:
        new_google_url = st.text_input(
            f"📋 {L['google_link']}",
            value=st.session_state.google_form_url_v12,
            key="settings_google_url_v12",
            placeholder="https://docs.google.com/forms/..."
        )

    b1, b2 = st.columns([1, 1])
    with b1:
        if st.button(
            L["save"],
            key="save_settings_v12",
            type="primary",
            use_container_width=True,
        ):
            st.session_state.selected_theme_v12 = new_theme
            st.session_state.selected_language_v12 = new_language
            st.session_state.app_location_v12 = new_location.strip() or "Kinshasa, RDC"
            st.session_state.display_mode_v14 = new_display_mode
            st.session_state.kobo_form_url_v12 = new_kobo_url.strip()
            st.session_state.google_form_url_v12 = new_google_url.strip()
            st.session_state.settings_open_v12 = False
            st.success(L["saved"])
            st.rerun()

    with b2:
        if st.button(
            "✖️ Fermer" if st.session_state.selected_language_v12 == "🇫🇷 Français"
            else "✖️ Close",
            key="close_settings_v12",
            use_container_width=True,
        ):
            st.session_state.settings_open_v12 = False
            st.rerun()

# ============================================================
# DESIGN V14
# Mode clair/nuit + cartes modernes + navigation visuelle.
# ============================================================
st.markdown(
    f"""
    <style>
    .stApp {{
        background:
            radial-gradient(circle at 10% 0%, {THEME["accent"]}18, transparent 28%),
            linear-gradient(135deg, {THEME["bg"]}, {THEME["bg2"]});
        color: {THEME["text"]};
        transition: background .35s ease;
    }}

    section[data-testid="stSidebar"] {{
        background: linear-gradient(180deg, {THEME["side"]}, {THEME["accent"]});
        border-right: 1px solid {THEME["border"]};
    }}

    section[data-testid="stSidebar"] * {{
        color: #FFFFFF !important;
    }}

    .v12-header {{
        padding: 5px 0 18px 4px;
    }}

    .v12-title {{
        font-size: 36px;
        font-weight: 900;
        letter-spacing: -.8px;
        color: {THEME["text"]};
    }}

    .v12-subtitle {{
        font-size: 14px;
        color: {THEME["muted"]};
        margin-top: 3px;
    }}

    .settings-panel {{
        background: {THEME["card"]};
        border: 1px solid {THEME["border"]};
        border-left: 5px solid {THEME["highlight"]};
        border-radius: 18px;
        padding: 18px 22px 8px;
        margin: 4px 0 18px;
        box-shadow: 0 12px 35px rgba(0,0,0,.10);
    }}

    .settings-title {{
        font-size: 22px;
        font-weight: 850;
        color: {THEME["text"]};
    }}

    .settings-subtitle {{
        font-size: 13px;
        color: {THEME["muted"]};
        margin-top: 3px;
    }}

    .hero {{
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 34px;
        margin: 4px 0 24px;
        color: #FFFFFF;
        background: linear-gradient(120deg, {THEME["side"]}, {THEME["accent"]}, {THEME["highlight"]});
        box-shadow: 0 18px 45px rgba(15,23,42,.18);
    }}

    .hero:before {{
        content: "";
        position: absolute;
        width: 190px;
        height: 190px;
        right: 5%;
        top: -90px;
        border-radius: 50%;
        background: #FFFFFF;
        opacity: .12;
        animation: float_v14 7s ease-in-out infinite;
    }}

    .hero:after {{
        content: "";
        position: absolute;
        width: 100px;
        height: 100px;
        right: 30%;
        bottom: -60px;
        border-radius: 50%;
        background: #FFFFFF;
        opacity: .10;
        animation: float_v14 5s ease-in-out infinite reverse;
    }}

    @keyframes float_v14 {{
        0%,100% {{ transform: translateY(0) rotate(0deg); }}
        50% {{ transform: translateY(-15px) rotate(8deg); }}
    }}

    .card {{
        border: 1px solid {THEME["border"]};
        border-radius: 18px;
        padding: 20px;
        background: {THEME["card"]};
        color: {THEME["text"]};
        box-shadow: 0 8px 28px rgba(15,23,42,.08);
    }}

    .form-access-card {{
        border-radius: 20px;
        padding: 26px 22px 20px;
        min-height: 150px;
        background: {THEME["card"]};
        border: 1px solid {THEME["border"]};
        box-shadow: 0 10px 28px rgba(15,23,42,.10);
        text-align: center;
        margin-bottom: 10px;
        transition: transform .2s ease, box-shadow .2s ease;
    }}

    .form-access-card:hover {{
        transform: translateY(-5px);
        box-shadow: 0 18px 40px rgba(15,23,42,.16);
    }}

    .form-access-icon {{ font-size: 44px; margin-bottom: 6px; }}
    .form-access-title {{ font-size: 22px; font-weight: 850; color: {THEME["text"]}; }}
    .form-access-text {{ font-size: 13px; color: {THEME["muted"]}; margin-top: 6px; }}

    .section-line {{
        height: 4px;
        width: 85px;
        border-radius: 10px;
        background: linear-gradient(90deg, {THEME["accent"]}, {THEME["highlight"]});
        margin: 8px 0 22px;
    }}

    div[data-testid="stMetric"] {{
        background: {THEME["card"]};
        border: 1px solid {THEME["border"]};
        border-radius: 16px;
        padding: 12px;
        box-shadow: 0 7px 22px rgba(15,23,42,.06);
    }}

    .stButton > button,
    .stDownloadButton > button,
    .stLinkButton > a {{
        border-radius: 13px !important;
        min-height: 46px;
        font-weight: 800;
        transition: transform .18s ease, box-shadow .18s ease;
    }}

    .stButton > button:hover,
    .stDownloadButton > button:hover,
    .stLinkButton > a:hover {{
        transform: translateY(-2px);
        box-shadow: 0 9px 22px rgba(15,23,42,.14);
    }}

    .status-strip {{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
        margin: 4px 0 20px;
    }}

    .status-pill {{
        padding:7px 12px;
        border-radius:999px;
        background:{THEME["card"]};
        border:1px solid {THEME["border"]};
        color:{THEME["muted"]};
        font-size:12px;
        font-weight:700;
    }}

    .status-pill strong {{ color:{THEME["text"]}; }}

    .live-dot {{
        display:inline-block;
        width:9px;
        height:9px;
        border-radius:50%;
        background:#22C55E;
        margin-right:6px;
        animation:pulse_v14 1.5s infinite;
    }}

    @keyframes pulse_v14 {{
        0% {{ box-shadow:0 0 0 0 #22C55E66; }}
        70% {{ box-shadow:0 0 0 9px transparent; }}
        100% {{ box-shadow:0 0 0 0 transparent; }}
    }}
    </style>
    """,
    unsafe_allow_html=True,
)

# DESIGN: thème personnalisé, cartes, animations CSS et boutons.
st.markdown(f'''<style>



.main-title{{font-size:42px;font-weight:850}}
.hero{{position:relative;overflow:hidden;border-radius:24px;padding:38px;margin-bottom:25px;color:black;background:linear-gradient(120deg,{THEME["side"]},{THEME["accent"]},#18a4b5);box-shadow:0 15px 40px #064a5730}}
.hero:before,.hero:after{{content:"";position:absolute;border-radius:50%;opacity:.2;animation:float 7s ease-in-out infinite}}
.hero:before{{width:190px;height:190px;right:5%;top:-90px;background:white}}
.hero:after{{width:100px;height:100px;right:30%;bottom:-60px;background:#66e9f7;animation-delay:1.4s}}
@keyframes float{{0%,100%{{transform:translateY(0)}}50%{{transform:translateY(-18px)}}}}
.hero-content{{position:relative;z-index:2}}
.hero h1{{margin:0;font-size:42px}}
.hero p{{font-size:17px;opacity:.92}}
.card{{border:1px solid #d8e9ed;border-radius:18px;padding:20px;background:#ffffffdd;box-shadow:0 7px 25px #20505a12}}
.source-card{{text-align:center;min-height:145px}}
.source-icon{{font-size:42px}}
.section-line{{height:3px;border-radius:4px;background:linear-gradient(90deg,{THEME["accent"]},#51d5e0,transparent);margin:8px 0 22px}}
.stButton>button{{border-radius:13px;min-height:48px;font-weight:750;transition:.2s}}
.stButton>button:hover{{transform:translateY(-2px);box-shadow:0 8px 20px #0a596633}}
.live-dot{{display:inline-block;width:10px;height:10px;border-radius:50%;background:#22c875;animation:pulse 1.5s infinite;margin-right:7px}}
@keyframes pulse{{70%{{box-shadow:0 0 0 10px transparent}}0%{{box-shadow:0 0 0 0 #22c87599}}}}

    .form-access-card {{
        border-radius: 20px;
        padding: 24px 22px 18px;
        min-height: 145px;
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        box-shadow: 0 10px 28px rgba(15,23,42,.08);
        text-align: center;
        margin-bottom: 10px;
        transition: transform .2s ease, box-shadow .2s ease;
    }}
    .form-access-card:hover {{
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(15,23,42,.13);
    }}
    .form-access-icon {{
        font-size: 42px;
        margin-bottom: 5px;
    }}
    .form-access-title {{
        font-size: 21px;
        font-weight: 850;
        color: #173F5F;
    }}
    .form-access-text {{
        font-size: 13px;
        color: #667085;
        margin-top: 5px;
    }}

</style>''',unsafe_allow_html=True)

# DATAFORGE_THEME_AWARE_CSS
st.markdown(
    """
    <style>
    :root {
        --df-bg: __BG__;
        --df-bg2: __BG2__;
        --df-card: __CARD__;
        --df-text: __TEXT__;
        --df-muted: __MUTED__;
        --df-border: __BORDER__;
        --df-side: __SIDE__;
        --df-accent: __ACCENT__;
        --df-highlight: __HIGHLIGHT__;
    }

    .stApp,
    [data-testid="stAppViewContainer"] {
        background: linear-gradient(135deg, var(--df-bg), var(--df-bg2)) !important;
        color: var(--df-text) !important;
    }

    [data-testid="stMarkdownContainer"],
    [data-testid="stText"],
    [data-testid="stCaptionContainer"],
    label, p, li, h1, h2, h3, h4, h5, h6 {
        color: var(--df-text) !important;
    }

    [data-testid="stCaptionContainer"] * {
        color: var(--df-muted) !important;
    }

    .card,
    .source-card,
    .form-access-card,
    .settings-panel,
    [data-testid="stMetric"] {
        background: var(--df-card) !important;
        color: var(--df-text) !important;
        border-color: var(--df-border) !important;
    }

    .card *,
    .source-card *,
    .form-access-card *,
    .settings-panel *,
    [data-testid="stMetric"] * {
        color: var(--df-text) !important;
    }

    .form-access-text,
    .settings-subtitle,
    .muted,
    .df-muted {
        color: var(--df-muted) !important;
    }

    input, textarea,
    div[data-baseweb="select"] > div,
    div[data-baseweb="input"] > div {
        background: var(--df-card) !important;
        color: var(--df-text) !important;
        border-color: var(--df-border) !important;
    }

    input::placeholder,
    textarea::placeholder {
        color: var(--df-muted) !important;
    }

    .stButton > button,
    .stDownloadButton > button,
    .stLinkButton > a {
        color: #FFFFFF !important;
        background: linear-gradient(
            135deg, var(--df-accent), var(--df-highlight)
        ) !important;
        border: 0 !important;
        border-radius: 13px !important;
        font-weight: 800 !important;
        transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }

    .stButton > button:hover,
    .stDownloadButton > button:hover,
    .stLinkButton > a:hover {
        color: #FFFFFF !important;
        transform: translateY(-2px);
        filter: brightness(1.08);
        box-shadow: 0 10px 24px rgba(15,23,42,.18);
    }

    section[data-testid="stSidebar"] {
        background: linear-gradient(
            180deg, var(--df-side), var(--df-accent)
        ) !important;
    }

    section[data-testid="stSidebar"] * {
        color: #FFFFFF !important;
    }

    .df-marquee-wrap {
        width: 100%;
        overflow: hidden;
        border-radius: 14px;
        margin: 4px 0 16px;
        background: linear-gradient(
            90deg, var(--df-side), var(--df-accent), var(--df-highlight)
        );
        box-shadow: 0 8px 24px rgba(15,23,42,.12);
    }

    .df-marquee {
        display: inline-block;
        white-space: nowrap;
        min-width: 100%;
        padding: 10px 0;
        animation: dataforge-scroll 24s linear infinite;
        font-size: 13px;
        font-weight: 800;
        color: #FFFFFF !important;
    }

    .df-marquee span {
        color: #FFFFFF !important;
        margin-right: 80px;
    }

    @keyframes dataforge-scroll {
        from { transform: translateX(100%); }
        to { transform: translateX(-100%); }
    }

    .df-status {
        color: var(--df-muted) !important;
        font-size: 13px;
        margin-bottom: 12px;
    }

    .df-status-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--df-highlight);
        margin-right: 7px;
        animation: dataforge-pulse 1.8s ease-in-out infinite;
    }

    @keyframes dataforge-pulse {
        0%, 100% { opacity: .45; transform: scale(.85); }
        50% { opacity: 1; transform: scale(1.15); }
    }
    </style>
    """.replace("__BG__", THEME["bg"])
       .replace("__BG2__", THEME["bg2"])
       .replace("__CARD__", THEME["card"])
       .replace("__TEXT__", THEME["text"])
       .replace("__MUTED__", THEME["muted"])
       .replace("__BORDER__", THEME["border"])
       .replace("__SIDE__", THEME["side"])
       .replace("__ACCENT__", THEME["accent"])
       .replace("__HIGHLIGHT__", THEME["highlight"]),
    unsafe_allow_html=True,
)


# FILE UTILS: sélection du fichier le plus récent et lecture sécurisée.
def latest(files):
    x=[f for f in files if f.exists()]
    return max(x,key=lambda f:f.stat().st_mtime) if x else None

def read_csv(path):
    try:return pd.read_csv(path)
    except Exception as e:st.error(f'Lecture impossible : {e}');return None

# DATA EXPLORER: filtres avancés + pagination + export du résultat.
# Cette section permet à l'utilisateur de :
# 1) sélectionner plusieurs pages ;
# 2) rechercher un texte dans toutes les colonnes textuelles ;
# 3) filtrer les colonnes catégorielles ;
# 4) filtrer automatiquement les colonnes numériques ;
# 5) parcourir le résultat avec une pagination ;
# 6) télécharger uniquement les lignes actuellement filtrées.

def table_view(df, key):
    st.markdown("### 🔎 Filtrer et parcourir les données")
    st.caption(
        "Utilisez plusieurs filtres simultanément. "
        "Le tableau et le téléchargement sont mis à jour automatiquement."
    )

    work = df.copy()

    # ---------------------------
    # BARRE DE RECHERCHE GLOBALE
    # ---------------------------
    search = st.text_input(
        "🔍 Recherche globale",
        placeholder="Ex. Toyota, Camry, Poetry, Dakar, Manuelle...",
        key=key + "_search",
    )

    if search.strip():
        mask = pd.Series(False, index=work.index)
        for col in work.columns:
            if work[col].dtype == "object" or pd.api.types.is_string_dtype(work[col]):
                mask = mask | work[col].astype(str).str.contains(
                    search.strip(), case=False, na=False, regex=False
                )
        work = work[mask]

    # ---------------------------
    # FILTRES
    # ---------------------------
    with st.expander("⚙️ Filtres avancés", expanded=True):
        f1, f2 = st.columns(2)

        # Sélection multiple des pages.
        if "page" in work.columns:
            page_values = sorted(
                pd.to_numeric(work["page"], errors="coerce")
                .dropna()
                .astype(int)
                .unique()
                .tolist()
            )
            with f1:
                selected_pages = st.multiselect(
                    "📄 Pages à afficher — sélection multiple",
                    page_values,
                    default=page_values,
                    key=key + "_pages",
                )
            if selected_pages:
                work = work[
                    pd.to_numeric(work["page"], errors="coerce").isin(selected_pages)
                ]
            else:
                work = work.iloc[0:0]

        # Filtres catégoriels utiles : marque, modèle, catégorie, boîte, région...
        categorical_candidates = []
        for col in work.columns:
            if col == "page":
                continue
            if work[col].dtype == "object" or pd.api.types.is_string_dtype(work[col]):
                nunique = work[col].dropna().astype(str).nunique()
                if 1 < nunique <= 40:
                    categorical_candidates.append(col)

        # On donne priorité aux colonnes métier les plus utiles.
        priority = [
            "category", "brand", "model", "gearbox",
            "availability", "rating", "region"
        ]
        categorical_candidates.sort(
            key=lambda c: (priority.index(c) if c in priority else 99, c)
        )

        for i, col in enumerate(categorical_candidates[:6]):
            values = sorted(work[col].dropna().astype(str).unique().tolist())
            selected = st.multiselect(
                f"🏷️ {col}",
                values,
                key=f"{key}_cat_{col}",
            )
            if selected:
                work = work[work[col].astype(str).isin(selected)]

        # Filtres numériques : prix, année, kilométrage, reviews, etc.
        numeric_cols = []
        for col in work.columns:
            numeric = pd.to_numeric(work[col], errors="coerce")
            if numeric.notna().sum() > 0 and numeric.nunique(dropna=True) > 1:
                numeric_cols.append(col)

        preferred_numeric = [
            "price", "mileage", "year", "reviews",
            "products_count", "position_page"
        ]
        numeric_cols.sort(
            key=lambda c: (
                preferred_numeric.index(c) if c in preferred_numeric else 99,
                c
            )
        )

        for col in numeric_cols[:4]:
            numeric = pd.to_numeric(work[col], errors="coerce").dropna()
            if numeric.empty:
                continue

            minimum = float(numeric.min())
            maximum = float(numeric.max())

            if minimum == maximum:
                continue

            step = 1.0
            if maximum >= 10000:
                step = 1000.0
            elif maximum >= 100:
                step = 10.0

            selected_range = st.slider(
                f"📐 {col}",
                min_value=minimum,
                max_value=maximum,
                value=(minimum, maximum),
                step=step,
                key=f"{key}_range_{col}",
            )

            numeric_all = pd.to_numeric(work[col], errors="coerce")
            work = work[
                numeric_all.between(
                    selected_range[0],
                    selected_range[1],
                    inclusive="both",
                )
            ]

    # ---------------------------
    # PAGINATION
    # ---------------------------
    rows_col, page_col, info_col = st.columns([1, 1, 2])

    with rows_col:
        rows = st.selectbox(
            "Lignes par page",
            [10, 25, 50, 100],
            index=1,
            key=key + "_rows",
        )

    total_pages = max(1, (len(work) + rows - 1) // rows)

    with page_col:
        current_page = st.selectbox(
            "Page du tableau",
            list(range(1, total_pages + 1)),
            index=0,
            key=key + "_table_page",
        )

    with info_col:
        st.metric(
            "Résultats",
            f"{len(work):,}",
            help="Nombre de lignes après application de tous les filtres.",
        )

    first = (current_page - 1) * rows
    last = first + rows
    displayed = work.iloc[first:last]

    st.dataframe(
        displayed,
        use_container_width=True,
        height=470,
        hide_index=True,
    )

    # ---------------------------
    # EXPORT DES DONNÉES FILTRÉES
    # ---------------------------
    csv_data = work.to_csv(index=False).encode("utf-8-sig")

    c1, c2 = st.columns([1, 4])
    with c1:
        st.download_button(
            "⬇️ Exporter le filtre",
            data=csv_data,
            file_name=f"{key}_filtered.csv",
            mime="text/csv",
            key=key + "_filtered_download",
            use_container_width=True,
        )
    with c2:
        st.caption(
            f"Affichage : lignes {first + 1 if len(work) else 0}–"
            f"{min(last, len(work))} sur {len(work):,} "
            f"• page {current_page}/{total_pages}"
        )

    return work


